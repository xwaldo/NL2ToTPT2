<Window x:Class="Importer.InputTestTarget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NL2ToTPT2 Instrumented Input Target"
        Width="940"
        Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid"
          Margin="24"
          Background="#20242B"
          Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="MoveSplineTab"
                    Width="180"
                    Height="48"
                    Margin="0,0,16,0"
                    Click="MoveSplineTab_Click"
                    Content="Move spline" />
            <Button x:Name="RotateSplineTab"
                    Width="180"
                    Height="48"
                    Click="RotateSplineTab_Click"
                    Content="Rotate spline" />
            <TextBlock x:Name="ModeText"
                       Margin="24,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="18"
                       Text="Mode: none" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Margin="0,0,0,14"
                           Foreground="White"
                           FontSize="20"
                           Text="Position fields" />
                <TextBlock Foreground="#BFC7D5" Text="X" />
                <TextBox x:Name="PositionX" Height="46" Margin="0,4,0,14" FontSize="18" />
                <TextBlock Foreground="#BFC7D5" Text="Y" />
                <TextBox x:Name="PositionY" Height="46" Margin="0,4,0,14" FontSize="18" />
                <TextBlock Foreground="#BFC7D5" Text="Z" />
                <TextBox x:Name="PositionZ" Height="46" Margin="0,4,0,14" FontSize="18" />
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,14"
                           Foreground="White"
                           FontSize="20"
                           Text="Rotation fields" />
                <TextBlock Foreground="#BFC7D5" Text="Yaw" />
                <TextBox x:Name="Yaw" Height="46" Margin="0,4,0,14" FontSize="18" />
                <TextBlock Foreground="#BFC7D5" Text="Pitch" />
                <TextBox x:Name="Pitch" Height="46" Margin="0,4,0,14" FontSize="18" />
                <TextBlock Foreground="#BFC7D5" Text="Roll" />
                <TextBox x:Name="Roll" Height="46" Margin="0,4,0,14" FontSize="18" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="FocusRelease"
                    Grid.Column="0"
                    Height="58"
                    Margin="0,0,24,0"
                    Background="#343A44"
                    CornerRadius="4"
                    MouseLeftButtonDown="FocusRelease_MouseLeftButtonDown">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#BFC7D5"
                           Text="Safe focus-release area" />
            </Border>
            <Button x:Name="BuildButton"
                    Grid.Column="1"
                    Width="180"
                    Height="58"
                    Click="BuildButton_Click"
                    Content="Build" />
        </Grid>
    </Grid>
</Window>
