<Window x:Class="Importer.UI.AutomationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NL2 to TPT2 - Auto mode"
        Width="800"
        Height="820"
        MinWidth="680"
        MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Text="Auto mode" />
                <TextBlock Margin="0,4,0,12"
                           Foreground="#5B6472"
                           Text="Calibrate Roblox controls, test with dry-run, then start live input." />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="12"
                    Background="#FDE8E8"
                    BorderBrush="#D92D20"
                    BorderThickness="1"
                    CornerRadius="4">
                <StackPanel>
                    <TextBlock x:Name="EmergencyHotkeyTextBlock"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#B42318"
                               Text="Emergency stop shortcut" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <Label Padding="0,0,4,0"
                               VerticalAlignment="Center"
                               Content="Ctrl+Shift+"
                               Target="{Binding ElementName=EmergencyHotkeyComboBox}" />
                        <ComboBox x:Name="EmergencyHotkeyComboBox"
                                  Width="62"
                                  AutomationProperties.Name="Emergency stop key after Ctrl+Shift" />
                        <Button x:Name="ApplyEmergencyHotkeyButton"
                                Margin="8,0,0,0"
                                Click="ApplyEmergencyHotkeyButton_Click"
                                Content="_Apply shortcut" />
                    </StackPanel>
                    <TextBlock x:Name="EmergencyHotkeyStatusTextBlock"
                               Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0"
                               TextWrapping="Wrap"
                               Text="This global shortcut stops automation without sending Undo. The Stop button remains available too." />
                </StackPanel>
            </Border>

            <GroupBox Grid.Row="2"
                      Margin="0,0,0,12"
                      Header="Calibration (saved automatically)">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="3"
                               Margin="0,0,0,8"
                               TextWrapping="Wrap"
                               Text="Capture minimizes this window and records the cursor after three seconds. Capture the Move and Rotate tabs first so the matching textbox group can be shown automatically. For focus release, choose a harmless blank area that does not change the selected track." />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Position X" />
                    <TextBlock x:Name="PositionXValueText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="Not calibrated" />
                    <Button Grid.Row="1" Grid.Column="2" Margin="8,3,0,3" Click="CaptureButton_Click" Content="_Capture" Tag="PositionX" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Position Y" />
                    <TextBlock x:Name="PositionYValueText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Text="Not calibrated" />
                    <Button Grid.Row="2" Grid.Column="2" Margin="8,3,0,3" Click="CaptureButton_Click" Content="_Capture" Tag="PositionY" />

                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Position Z" />
                    <TextBlock x:Name="PositionZValueText" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Text="Not calibrated" />
                    <Button Grid.Row="3" Grid.Column="2" Margin="8,3,0,3" Click="CaptureButton_Click" Content="_Capture" Tag="PositionZ" />

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Yaw" />
                    <TextBlock x:Name="YawValueText" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="Not calibrated" />
                    <Button Grid.Row="4" Grid.Column="2" Margin="8,3,0,3" Click="CaptureButton_Click" Content="_Capture" Tag="Yaw" />

                    <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Pitch" />
                    <TextBlock x:Name="PitchValueText" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Text="Not calibrated" />
                    <Button Grid.Row="5" Grid.Column="2" Margin="8,3,0,3" Click="CaptureButton_Click" Content="_Capture" Tag="Pitch" />

                    <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Roll" />
                    <TextBlock x:Name="RollValueText" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Text="Not calibrated" />
                    <Button Grid.Row="6" Grid.Column="2" Margin="8,3,0,3" Click="CaptureButton_Click" Content="_Capture" Tag="Roll" />

                    <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Focus release area" />
                    <TextBlock x:Name="FocusReleaseValueText" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Text="Not calibrated" />
                    <Button Grid.Row="7" Grid.Column="2" Margin="8,3,0,3" Click="CaptureButton_Click" Content="_Capture" Tag="FocusRelease" />

                    <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="Move spline tab" />
                    <TextBlock x:Name="MoveSplineTabValueText" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" Text="Not calibrated" />
                    <Button Grid.Row="8" Grid.Column="2" Margin="8,3,0,3" Click="CaptureButton_Click" Content="_Capture" Tag="MoveSplineTab" />

                    <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="Rotate spline tab" />
                    <TextBlock x:Name="RotateSplineTabValueText" Grid.Row="9" Grid.Column="1" VerticalAlignment="Center" Text="Not calibrated" />
                    <Button Grid.Row="9" Grid.Column="2" Margin="8,3,0,3" Click="CaptureButton_Click" Content="_Capture" Tag="RotateSplineTab" />

                    <TextBlock Grid.Row="10" VerticalAlignment="Center" Text="Build button" />
                    <TextBlock x:Name="BuildButtonValueText" Grid.Row="10" Grid.Column="1" VerticalAlignment="Center" Text="Not calibrated" />
                    <Button Grid.Row="10" Grid.Column="2" Margin="8,3,0,3" Click="CaptureButton_Click" Content="_Capture" Tag="BuildButton" />

                    <Button x:Name="ClearSavedCalibrationButton"
                            Grid.Row="11"
                            Grid.Column="2"
                            Margin="8,8,0,0"
                            Click="ClearSavedCalibrationButton_Click"
                            Content="C_lear saved" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3"
                      Margin="0,0,0,12"
                      Header="Run and compatibility settings">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Start at section" />
                    <TextBox x:Name="StartSectionTextBox" Grid.Row="0" Grid.Column="1" Margin="5" Text="1" />
                    <CheckBox x:Name="DryRunCheckBox"
                              Grid.Row="0"
                              Grid.Column="2"
                              Grid.ColumnSpan="2"
                              Margin="8,5"
                              VerticalAlignment="Center"
                              Content="Dry-run (no OS input)"
                              IsChecked="False" />
                    <TextBlock x:Name="SectionCountTextBlock"
                               Grid.Row="0"
                               Grid.Column="4"
                               VerticalAlignment="Center"
                               Foreground="#5B6472" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Mouse movement (ms)" />
                    <TextBox x:Name="MouseMovementDelayTextBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="5"
                             Text="50"
                             ToolTip="Snap micro-glide duration, or minimum duration in Full glide mode" />
                    <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Target hold (ms)" />
                    <TextBox x:Name="InputDelayTextBox"
                             Grid.Row="1"
                             Grid.Column="3"
                             Margin="5"
                             Text="50"
                             ToolTip="Repeated exact-target position updates before input, post-click settling, and Roblox focus settling" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="4"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#5B6472"
                               Text="Raise these if Roblox's cursor lands late." />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Mouse button (ms)" />
                    <TextBox x:Name="MouseButtonDelayTextBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="5"
                             Text="40"
                             ToolTip="Time between mouse-down and mouse-up events" />
                    <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="Text step (ms)" />
                    <TextBox x:Name="TextInputDelayTextBox"
                             Grid.Row="2"
                             Grid.Column="3"
                             Margin="5"
                             Text="20"
                             ToolTip="Time between select, clear, complete-value input, decimal separation, and Enter" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="4"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#5B6472"
                               Text="Raise the specific delay only if clicks or text are missed." />

                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Tab settle (ms)" />
                    <TextBox x:Name="ModeSwitchDelayTextBox" Grid.Row="3" Grid.Column="1" Margin="5" Text="20" />
                    <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="Build settle (ms)" />
                    <TextBox x:Name="BuildDelayTextBox" Grid.Row="3" Grid.Column="3" Margin="5" Text="20" />

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Mouse movement mode" />
                    <ComboBox x:Name="MouseMovementModeComboBox"
                              Grid.Row="4"
                              Grid.Column="1"
                              Grid.ColumnSpan="2"
                              Margin="5"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Snap + micro-glide" Tag="SnapMicroGlide" />
                        <ComboBoxItem Content="Full glide (compatibility)" Tag="FullGlide" />
                    </ComboBox>
                    <TextBlock Grid.Row="4"
                               Grid.Column="3"
                               Grid.ColumnSpan="2"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#5B6472"
                               Text="Snaps near the target, then settles exactly over several frames." />

                    <Border Grid.Row="5"
                            Grid.ColumnSpan="5"
                            Margin="0,8,0,0"
                            Padding="8"
                            Background="#DCEBFF"
                            BorderBrush="#8CB5E8"
                            BorderThickness="1"
                            CornerRadius="3">
                        <TextBlock x:Name="AnchorSummaryTextBlock"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="4"
                        Margin="0,0,0,12"
                        Orientation="Horizontal">
                <Button x:Name="StartButton"
                        Click="StartButton_Click"
                        Content="_Start" />
                <Button x:Name="PauseButton"
                        Click="PauseButton_Click"
                        Content="_Pause"
                        IsEnabled="False" />
                <Button x:Name="StopButton"
                        Click="StopButton_Click"
                        Content="S_top"
                        IsEnabled="False" />
            </StackPanel>

            <GroupBox Grid.Row="5"
                      Margin="0,0,0,12"
                      Header="Progress">
                <StackPanel Margin="10">
                    <TextBlock x:Name="AutomationStateTextBlock"
                               FontWeight="SemiBold"
                               Text="Idle" />
                    <TextBlock x:Name="AutomationMessageTextBlock"
                               Margin="0,3,0,6"
                               Foreground="#5B6472"
                               Text="Ready. Review the Guide before starting live input." />
                    <ProgressBar x:Name="AutomationProgressBar"
                                 Height="12"
                                 Minimum="0" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="6" Header="Import log">
                <TextBox x:Name="ImportLogTextBox"
                         MinHeight="150"
                         Margin="10"
                         FontFamily="Consolas"
                         FontSize="12"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Window>
